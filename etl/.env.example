# ====================================================================
# Configuración del Pipeline ETL: Supabase -> GCS Data Lake -> BigQuery DWH
# Tacna SOC — Centro de Operaciones de Seguridad
# ====================================================================

# 1. Origen de Datos Operacional: Supabase PostgreSQL
SUPABASE_URL="https://zyjgfkqqiefydvevmfqh.supabase.co"
SUPABASE_KEY="sb_publishable_xBh3bXmfP-oRTKh4NKhXRQ_E5vJE5T2"
# Alternativa directa con conexión PostgreSQL si está disponible:
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.zyjgfkqqiefydvevmfqh.supabase.co:5432/postgres"

# 2. Destino Cloud: Google Cloud Platform (GCP)
GCP_PROJECT_ID="tacna-soc-bi-cloud-2026"
GCP_REGION="us-central1"
GCS_LAKE_BUCKET="tacna-soc-datalake-raw-production"
BQ_DATASET_ID="tacna_soc_dwh"

# 3. Credenciales de Servicio de GCP (para ejecución local o contenedor fuera de Cloud Run)
# En Cloud Run no se requiere esta variable ya que hereda el Service Account asignado
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-key.json"

# 4. Modo de Ejecución
# DRY_RUN=true permite extraer, transformar y exportar el esquema estrella localmente en etl/output/
DRY_RUN="false"
FULL_REFRESH="false"

